<!-- Vendored from vitamin src/robot/vita02a/vita02a_nomesh.xml (A-sample:
     serial-ankle model, 2-DoF neck, wrist chain roll->yaw->pitch). The nomesh
     variant is used on purpose: retargeting is headless, so the 54 MB of STL
     meshes stay out of this repo; the box, cylinder primitives carry all the
     contacts. Bridge-side change vs upstream: massless left/right_toe_link
     GMR IK marker bodies added under the ankle_roll links (same recipe as
     vita02.xml). Body hierarchy, joints, actuators, and sensors otherwise
     match upstream vita02a.xml exactly. -->
<mujoco model="vita02a">
  <compiler angle="radian" meshdir="meshes/"/>
  <option cone="elliptic" impratio="100"/>
  <default>
    <default class="vt">
      <geom margin="0.001" condim="3" group="3"/>
      <joint damping="0" stiffness="0" frictionloss="0"/>
      <!--
        Visual geoms: render-only, no contacts, group 1 so the sim-app
        viewer can toggle them via geomgroup[1].
      -->
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="1" density="0"
              rgba="0.75294 0.75294 0.75294 1"/>
      </default>
      <!--
        Collision primitives: keep the vt-class defaults (margin/condim,
        group 3 for the viewer's collision toggle). contype/conaffinity=1
        is the MJCF default but we set them explicitly so the contract is
        visible at a glance.
      -->
      <default class="collision">
        <geom group="3" contype="1" conaffinity="1"
              rgba="0.75294 0.75294 0.75294 1"/>
      </default>
      <!--
        On the A sample every hip axis (pitch/roll/yaw) and the knee use the
        120 Nm EYOU_RP actuator, so they share the vita02 EYOU_RP armature.
      -->
      <!--
        Per-class joint dynamics: armature = rotor inertia x gear ratio^2
        from the A-sample motor table (wiki 人形参数). damping/frictionloss
        are initial estimates pending system identification.
      -->
      <default class="vt_hips">
        <joint armature="0.044800754" damping="1.0" frictionloss="0.5"/>
        <motor ctrlrange="-120.0 120.0" forcerange="-120.0 120.0"/>
      </default>
      <default class="vt_knee">
        <joint armature="0.044800754" damping="1.0" frictionloss="0.5"/>
        <motor ctrlrange="-120.0 120.0" forcerange="-120.0 120.0"/>
      </default>
      <default class="vt_feet">
        <joint armature="0.030135000" damping="1.0" frictionloss="0.5"/>
        <motor ctrlrange="-70.5 70.5" forcerange="-70.5 70.5"/>
      </default>
      <default class="vt_waist">
        <joint armature="0.015067500" damping="1.0" frictionloss="0.5"/>
        <motor ctrlrange="-70.5 70.5" forcerange="-70.5 70.5"/>
      </default>
      <default class="vt_arms">
        <joint armature="0.015900000" damping="0.5" frictionloss="0.3"/>
        <motor ctrlrange="-60.0 60.0" forcerange="-60.0 60.0"/>
      </default>
      <!--
        Wrist (10 Nm forearm) and neck (2 Nm head) actuators: armature =
        rotor inertia x gear ratio^2 from the A-sample motor table
        (8.3e-6 x 19.5278^2, 1.18e-6 x 25^2).
      -->
      <default class="vt_wrist">
        <joint armature="0.003165080" damping="0.2" frictionloss="0.1"/>
        <motor ctrlrange="-15.0 15.0" forcerange="-15.0 15.0"/>
      </default>
      <default class="vt_neck">
        <joint armature="0.000737500" damping="0.1" frictionloss="0.05"/>
        <motor ctrlrange="-6.0 6.0" forcerange="-6.0 6.0"/>
      </default>
    </default>
  </default>
